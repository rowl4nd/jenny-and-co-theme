{% comment %}
  JENNY & CO — Look Closely
  Signature section. Finished artwork with detail crops that lift out of it.
{% endcomment %}

<div class="jc-lc section-wrapper" style="--jc-lc-pad-start: {{ section.settings.padding_top }}px; --jc-lc-pad-end: {{ section.settings.padding_bottom }}px;">
  <div class="jc-lc__inner">

    <header class="jc-lc__head">
      <h2 class="jc-lc__title">{{ section.settings.heading }}</h2>
      {% if section.settings.standfirst != blank %}
        <p class="jc-lc__standfirst">{{ section.settings.standfirst }}</p>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="jc-lc__body">{{ section.settings.body }}</div>
      {% endif %}
    </header>

    <div class="jc-lc__stage">
      {% if section.settings.main_image %}
        <figure class="jc-lc__main">
          {{
            section.settings.main_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 900px) 60vw, 100vw',
              widths: '600, 900, 1200, 1600',
              alt: section.settings.main_image.alt | default: section.settings.heading
          }}
        </figure>
      {% else %}
        <div class="jc-lc__main jc-lc__placeholder">
          {{ 'collection-apparel-1' | placeholder_svg_tag: 'jc-lc__placeholder-svg' }}
        </div>
      {% endif %}

      <ul class="jc-lc__details" role="list">
        {% for i in (1..3) %}
          {% liquid
            assign img_key = 'detail_image_' | append: i
            assign label_key = 'detail_label_' | append: i
            assign img = section.settings[img_key]
            assign label = section.settings[label_key]
          %}
          {% if img or label != blank %}
            <li class="jc-lc__detail jc-lc__detail--{{ i }}">
              <div class="jc-lc__detail-media">
                {% if img %}
                  {{
                    img
                    | image_url: width: 600
                    | image_tag: loading: 'lazy', widths: '300, 450, 600', alt: img.alt | default: label
                  }}
                {% else %}
                  {{ 'collection-apparel-2' | placeholder_svg_tag: 'jc-lc__placeholder-svg' }}
                {% endif %}
              </div>
              {% if label != blank %}
                <span class="jc-lc__detail-label">{{ label }}</span>
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a class="jc-lc__cta" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}

  </div>
</div>

{% stylesheet %}
  .jc-lc {
    background-color: var(--color-background);
    padding-block: var(--jc-lc-pad-start, 96px) var(--jc-lc-pad-end, 96px);
  }

  .jc-lc__inner {
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 24px);
  }

  /* ---- Header ---- */

  .jc-lc__head {
    max-width: 46ch;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .jc-lc__title {
    font-family: var(--jc-hand, var(--font-h1--family));
    font-size: clamp(2.75rem, 1.8rem + 4.2vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: 0.015em;
    color: var(--jc-green, #234838);
    margin: 0;
  }

  .jc-lc__standfirst {
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.45rem);
    line-height: 1.45;
    margin: 1rem 0 0;
    color: var(--color-foreground);
  }

  .jc-lc__body {
    margin-top: 1.25rem;
    line-height: 1.7;
  }

  .jc-lc__body p { margin: 0 0 0.9em; }

  /* ---- Stage ---- */

  .jc-lc__stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: end;
  }

  .jc-lc__main {
    grid-column: 1 / span 8;
    margin: 0;
  }

  .jc-lc__main img,
  .jc-lc__placeholder-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .jc-lc__details {
    grid-column: 7 / -1;
    grid-row: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 2rem);
    align-self: center;
  }

  .jc-lc__detail {
    position: relative;
    background: var(--color-background);
    padding: 10px 10px 0;
    box-shadow: 0 18px 40px -24px rgb(35 72 56 / 0.45);

    /* lift-out */
    opacity: 0;
    transform: translateY(28px) scale(0.96);
    animation: jc-lc-lift linear both;
    animation-timeline: view();
    animation-range: entry 15% cover 42%;
  }

  /* staggered offsets so they don't read as a tidy column */
  .jc-lc__detail--1 { margin-inline-start: 0; width: 68%; }
  .jc-lc__detail--2 { margin-inline-start: 22%; width: 74%; }
  .jc-lc__detail--3 { margin-inline-start: 6%;  width: 64%; }

  .jc-lc__detail-media img,
  .jc-lc__detail-media .jc-lc__placeholder-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .jc-lc__detail-label {
    display: block;
    font-family: var(--font-paragraph--family);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--jc-green, #234838);
    padding: 0.75rem 0.25rem 0.85rem;
  }

  @keyframes jc-lc-lift {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* No scroll-driven animation support — just show them. */
  @supports not (animation-timeline: view()) {
    .jc-lc__detail {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  /* ---- CTA ---- */

  .jc-lc__cta {
    display: inline-block;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    font-family: var(--font-paragraph--family);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--jc-green, #234838);
    text-decoration: none;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid currentColor;
  }

  /* ---- Mobile ---- */

  @media screen and (max-width: 749px) {
    .jc-lc__stage {
      display: block;
    }

    .jc-lc__details {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin-top: -12%;
      padding-inline-start: 8%;
    }

    .jc-lc__detail--1,
    .jc-lc__detail--2,
    .jc-lc__detail--3 {
      width: 100%;
      margin-inline-start: 0;
    }

    .jc-lc__detail--3 { grid-column: 1 / -1; width: 60%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .jc-lc__detail {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Look Closely",
  "tag": "section",
  "class": "jc-lc-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Look closely..."
    },
    {
      "type": "text",
      "id": "standfirst",
      "label": "Standfirst",
      "default": "There's more going on than you think."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>My work starts with pen and paint. Then I add tiny pieces of Liberty fabric before finishing each piece with free-machine stitching.</p><p>Familiar places, animals and everyday things — usually with a little bit of fun thrown in.</p>"
    },
    {
      "type": "header",
      "content": "Artwork"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Finished piece"
    },
    {
      "type": "header",
      "content": "Details"
    },
    {
      "type": "image_picker",
      "id": "detail_image_1",
      "label": "Detail 1 image"
    },
    {
      "type": "text",
      "id": "detail_label_1",
      "label": "Detail 1 label",
      "default": "Pen & paint"
    },
    {
      "type": "image_picker",
      "id": "detail_image_2",
      "label": "Detail 2 image"
    },
    {
      "type": "text",
      "id": "detail_label_2",
      "label": "Detail 2 label",
      "default": "Liberty fabric"
    },
    {
      "type": "image_picker",
      "id": "detail_image_3",
      "label": "Detail 3 image"
    },
    {
      "type": "text",
      "id": "detail_label_3",
      "label": "Detail 3 label",
      "default": "Free-machine stitch"
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Shop the artwork"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Look Closely"
    }
  ]
}
{% endschema %}
