{
  "sections": {
    "hero": {
      "type": "hero",
      "blocks": {
        "headline": {
          "type": "text",
          "settings": {
            "text": "<h1>Drawn.<br>Painted.<br>Stitched.</h1>",
            "width": "fit-content",
            "alignment": "left",
            "type_preset": "h1",
            "wrap": "balance",
            "text_color": "#F7F1E8"
          }
        },
        "standfirst": {
          "type": "text",
          "settings": {
            "text": "<p>Original artwork, prints and lovely things created in my West Kirby studio.</p>",
            "width": "fit-content",
            "max_width": "narrow",
            "alignment": "left",
            "type_preset": "paragraph",
            "text_color": "#F7F1E8"
          }
        },
        "cta": {
          "type": "button",
          "settings": {
            "label": "Shop the artwork",
            "link": "shopify://collections/all",
            "style_class": "button-primary",
            "width": "fit-content"
          }
        },
        "cta_studio": {
          "type": "button",
          "settings": {
            "label": "Visit the studio",
            "link": "shopify://pages/visit",
            "style_class": "button-secondary",
            "width": "fit-content"
          }
        }
      },
      "block_order": ["headline", "standfirst", "cta", "cta_studio"],
      "settings": {
        "media_type_1": "image",
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment_flex_direction_column": "flex-start",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 20,
        "section_width": "page-width",
        "section_height": "large",
        "toggle_overlay": true,
        "overlay_color": "#23483866",
        "overlay_style": "gradient",
        "gradient_direction": "to right",
        "padding-block-start": 80,
        "padding-block-end": 80
      }
    },

    "look_closely": {
      "type": "jc-look-closely",
      "settings": {
        "heading": "Look closely...",
        "standfirst": "There's more going on than you think.",
        "body": "<p>My work starts with pen and paint. Then I add tiny pieces of Liberty fabric before finishing each piece with free-machine stitching.</p><p>Familiar places, animals and everyday things — usually with a little bit of fun thrown in.</p>",
        "detail_label_1": "Pen & paint",
        "detail_label_2": "Liberty fabric",
        "detail_label_3": "Free-machine stitch",
        "button_label": "Shop the artwork",
        "button_link": "shopify://collections/all",
        "padding_top": 112,
        "padding_bottom": 112
      }
    },

    "collections": {
      "type": "collection-list",
      "settings": {
        "layout_type": "grid",
        "columns": 3,
        "mobile_columns": "1",
        "max_collections": 3,
        "columns_gap": 12,
        "rows_gap": 12,
        "section_width": "page-width",
        "padding-block-start": 32,
        "padding-block-end": 64
      }
    },

    "featured": {
      "type": "product-list",
      "blocks": {
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "blocks": {
            "gallery": {
              "type": "_product-card-gallery",
              "settings": { "image_ratio": "adapt" }
            },
            "title": {
              "type": "product-title",
              "settings": { "type_preset": "paragraph", "alignment": "left" }
            },
            "price": {
              "type": "price",
              "settings": { "type_preset": "paragraph", "alignment": "left" }
            }
          },
          "block_order": ["gallery", "title", "price"]
        }
      },
      "settings": {
        "collection": "all",
        "layout_type": "grid",
        "max_products": 8,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 16,
        "rows_gap": 32,
        "section_width": "page-width",
        "padding-block-start": 64,
        "padding-block-end": 96
      }
    }
  },

  "order": ["hero", "look_closely", "collections", "featured"]
}
